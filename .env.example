# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Main model (query analysis + answer generation)
GROQ_MODEL=openai/gpt-oss-120b
# Smaller model (document grading, query rewriting, hallucination check)
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Optional tuning
# TOP_K=5
# MAX_RETRIES=2
# MAX_GENERATIONS=2
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150

# Optional: web search fallback when the corpus has nothing relevant
# (free key at https://tavily.com)
# TAVILY_API_KEY=your_tavily_key_here

# Optional: describe the corpus (used by the query-analysis prompt).
# Change this if you ingest docs about a different topic.
# CORPUS_DESCRIPTION=the official FastAPI tutorial: path and query parameters, request bodies, errors, dependencies
